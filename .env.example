# ── Clerk Auth
# Get from: https://dashboard.clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# ── Turso Database
# Get from: https://turso.tech → Your Database → Connect
TURSO_DATABASE_URL=libsql://your-db-name.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Anthropic AI (Claude Haiku)
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ── App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Admin (optional)
# Set to your Clerk user ID to enable the pack feature-toggle endpoint
# Find your user ID at: https://dashboard.clerk.com → Users
ADMIN_USER_ID=user_3D1TVafSQ5narvaPG0K6SkID7ll
